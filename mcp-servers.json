{
  "servers": {
    "workspace": {
      "type": "stdio",
      "command": "python3 mcp/server.py",
      "env": {
        "JARVIS_WORKSPACE": "."
      }
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx @playwright/mcp@latest --browser chromium"
    }
  }
}
